{
  // Copy this file over meteora-invent/studio/config/dbc_config.jsonc before running studio
  // commands, or point studio at it directly if your checkout supports a --config-file flag.
  // Everything below follows the real schema from studio/config/dbc_config.jsonc in
  // github.com/MeteoraAg/meteora-invent. See README.md in this module for the reasoning
  // behind each value.

  "rpcUrl": "https://api.devnet.solana.com", // switch to mainnet-beta only after the POC passes

  "dryRun": false, // leave true until you have watched a full dry run pass with no errors

  "keypairFilePath": "./keypair.json", // generated by: pnpm studio generate-keypair --network devnet --airdrop

  "computeUnitPriceMicroLamports": 100000,

  // Devnet USDC (Circle). Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
  "quoteMint": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",

  "dbcConfig": {
    "buildCurveMode": 0, // buildCurve: single segment, monotonic price

    "percentageSupplyOnMigration": 20, // 20% of total supply migrates into the DAMM v2 pool
    "migrationQuoteThreshold": 12, // POC goal amount in USDC. Real goals use their own target.

    "token": {
      "totalTokenSupply": 1000000000,
      "tokenBaseDecimal": 6, // matches USDC decimals
      "tokenQuoteDecimal": 6, // USDC has 6 decimals (not 9, that is SOL)
      "tokenType": 0, // SPL Token
      "tokenAuthorityOption": 1, // Immutable
      "leftover": 0
    },

    "fee": {
      "baseFeeParams": {
        "baseFeeMode": 0, // Fee Scheduler: Linear
        "feeSchedulerParam": {
          "startingFeeBps": 100, // flat 1% fee, start and end equal
          "endingFeeBps": 100,
          "numberOfPeriod": 0,
          "totalDuration": 0
        }
      },
      "dynamicFeeEnabled": false, // off for the POC, revisit once the pipeline is proven
      "collectFeeMode": 0, // fees collected in quote token (USDC) only
      "creatorTradingFeePercentage": 50, // PLACEHOLDER, needs a real product decision
      "poolCreationFee": 0,
      "enableFirstSwapWithMinFee": false
    },

    "migration": {
      "migrationOption": 1, // DAMM v2
      "migrationFeeOption": 3, // LP Fee 2%
      "migrationFee": {
        "feePercentage": 0,
        "creatorFeePercentage": 0
      }
    },

    // Must total 100%. At least 10% must stay locked or vesting for 1+ day post-migration.
    // Here: 100% goes to the goal creator address, permanently locked. See README.md,
    // "Design note: who is creator for a family/community goal" before wiring a real address in.
    "liquidityDistribution": {
      "partnerLiquidityPercentage": 0,
      "creatorLiquidityPercentage": 0,
      "partnerPermanentLockedLiquidityPercentage": 0,
      "creatorPermanentLockedLiquidityPercentage": 100
    },

    "lockedVesting": {
      "totalLockedVestingAmount": 0,
      "numberOfVestingPeriod": 0,
      "cliffUnlockAmount": 0,
      "totalVestingDuration": 0,
      "cliffDurationFromMigrationTime": 0
    },

    "activationType": 1, // timestamp

    // Treasury address resolved in principle, blocked on deploy in practice. Per ACCOUNTS.md
    // (Cognata program, root of repo): this is the Treasury PDA, seeds = [b"treasury"] under the
    // Cognata program ID. Reuse it here rather than deriving a second DBC-specific PDA, per
    // ACCOUNTS.md's own guidance ("Why this is the answer for the DBC treasury too").
    // Not filled in below because the program ID in ACCOUNTS.md is an explicit pre-deploy
    // placeholder (`anchor keys sync` will change it). Deriving the PDA against a placeholder ID
    // would produce an address that goes stale at deploy, not a real one. See PROCESS_LOG.md
    // section 4.3 for the full resolution note and the exact derivation to run once deployed.
    "leftoverReceiver": "BoPLuCRknf79Dr3YpCT7Q5D7HMjYTubRWKqMgrTjYN27", // real Cognata treasury PDA (program EPqdJo6sJP9R3RCKh2RFLMt7T6orrkjV1ub584dcM2Vr, devnet, deployed Oct 1)
    "feeClaimer": "BoPLuCRknf79Dr3YpCT7Q5D7HMjYTubRWKqMgrTjYN27"
  },

  "dbcPool": {
    "creator": "F7BHT2uEbyf6d5abLUmyL7NB8YZ8VcXhkzRw5DSNZG6J", // Tunde's devnet wallet
    "name": "GOAL_TOKEN_NAME",
    "symbol": "GOALSYM",
    "metadata": {
      "image": "./data/image/test-token.jpg",
      "description": "GOAL_TOKEN_DESCRIPTION",
      "website": "https://example.com",
      "twitter": "https://x.com/example",
      "telegram": "https://t.me/example"
    }
  },

  "dbcSwap": {
    "amountIn": 0.5, // POC buy-in amount in USDC, adjust per test
    "slippageBps": 500,
    "swapBaseForQuote": false, // false = buying the goal token with USDC
    "referralTokenAccount": null
  },

  "dbcTransferPoolCreator": {
    "newCreator": "REPLACE_IF_TRANSFERRING_OWNERSHIP"
  }
}
